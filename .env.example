# ─────────────────────────────────────────────────────────────────────────────
# LIFE GAME OS — environment variables
# Copy to `.env.local`. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Leave UNSET for local development: the app runs an embedded Postgres (PGlite)
# persisted to ./.data/pglite, so no database server is required.
# Set to a real Postgres connection string for production (Neon, Supabase, RDS…).
# DATABASE_URL="postgres://user:password@host:5432/life_game_os?sslmode=require"

# ── Sessions (REQUIRED in production) ───────────────────────────────────────
# 32+ random bytes. Generate with:  openssl rand -base64 48
# In development a fixed development-only fallback is used if this is unset.
SESSION_SECRET=""

# ── AI provider ─────────────────────────────────────────────────────────────
# Supply EITHER key, or neither. With no key the app uses the deterministic mock
# provider and remains fully functional — onboarding, council, game generation, all
# of it. Anthropic wins if both are set, because the agent charters were written
# and evaluated against it.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Force a provider. "auto" (default) picks anthropic, then openai, then mock.
# auto | anthropic | openai | mock
AI_PROVIDER="auto"

# Model tiering for cost control. See docs/agent-architecture.md §3.
# LEAVE THESE UNSET unless you mean to override: the defaults follow the active
# provider, and a hard-coded Claude id sent to OpenAI (or vice versa) is a 400.
#   anthropic → claude-opus-5    / claude-sonnet-5 / claude-haiku-4-5
#   openai    → gpt-5.5          / gpt-5.4         / gpt-5.4-mini
# AI_MODEL_DEEP=""
# AI_MODEL_STANDARD=""
# AI_MODEL_LIGHT=""

# Embeddings, OpenAI only. Unused today; reserved for semantic memory retrieval.
# AI_MODEL_EMBEDDING="text-embedding-3-small"

# Hard ceiling on agents invoked per council run (belt-and-braces cost guard).
AI_MAX_AGENTS_PER_RUN="8"

# Cost rates in USD per million tokens, for the figures in /admin. Claude models are
# priced in code; anything else is reported as "Unpriced" until you supply a rate
# here, so the dashboard is never confidently wrong about spend.
# AI_PRICING_JSON='{"gpt-5.5":{"input":1.25,"output":10},"gpt-5.4-mini":{"input":0.25,"output":2}}'

# ── Observability ───────────────────────────────────────────────────────────
# Expose /admin (agent runs, latency, cost, validation, conflicts).
ENABLE_ADMIN="true"

# ── App ─────────────────────────────────────────────────────────────────────
# Used for absolute URLs in exports. Optional in development.
# NEXT_PUBLIC_APP_URL="https://your-deployment.vercel.app"
